{
  "name": "google-cloud-db-context-engineering",
  "version": "0.7.3",
  "contextFileName": "./plugin/GEMINI.md",
  "mcpServers": {
    "db-context-engineering": {
      "command": "uvx",
      "args": [
        "google-cloud-db-context-engineering@0.7.3"
      ]
    },
    "toolbox": {
      "command": "uvx",
      "args": [
        "toolbox-server@1.10.0",
        "--config",
        ".context-engineering/tools.yaml",
        "--stdio"
      ]
    },
    "contextmgmt": {
      "httpUrl": "https://staging-dataplex.sandbox.googleapis.com/mcp/managed-context-sets",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
      }
    }
  }
}
